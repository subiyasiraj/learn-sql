-- select total number of customers - 
select count(*)
from customers

-- find sum, max, min and avg of scores --
select sum(score) sum_score, max(Score) max_score,min(score) min_score, avg(coalesce(score,0)) avg_Score
from customers

-- find the total orders across each product --
select count(*), ProductID
from orders
group by ProductID

-- total sales for each product also provide orderID and OrderDate --
select distinct sum(sales) over(partition by productID) total_sum, productID, OrderID, OrderDate
from orders

-- window function with aggregate --
select productID, OrderDate, sum(sales) 
over(partition by productID order by 
productID rows between 
current row and unbounded following)
from Orders

-- Rank customers based on their total sales --
SELECT customerID, sum(sales) as sales, rank() over(order by sum(sales))
FROM orders
group by customerID

-- count - check repeated countries --
select *
from (select count(country) over(partition by country) as num, country
from customers
) check_PK
where num > 1

-- SUM - find total sales, sales by product and orderID and Order Date --
select sum(sales) over() , sum(sales) over(partition by productID), orderID, orderDate
from orders

-- avg - find the average of sales by product --
select avg(coalesce(sales,0)) over(partition by productID), orderID, orderDate
from Orders

-- Find orders with sales above the average sales per order --
SELECT sales, orderID
FROM orders
WHERE sales > (
    SELECT AVG(COALESCE(sales, 0))
    FROM orders
);

-- Min and Max - find the average of sales by product --
select min(sales) over(), max(sales) over(), min(sales) over(partition by productID), max(sales) over(partition by productID)
from orders

-- Min and Max - list of employees having highest salary --
select *
from (select max(salary) over() max_Salary, firstName, salary
from employees)t
where salary = max_Salary

-- Min and Max - deviation from min and max --
select *,max(sales) over() - sales as dev_max,sales - min(sales) over() as dev_min
from orders

-- running total - from day1 --
select *, sum(sales) over(order by productID rows between unbounded preceding and current row)
from orders

-- rolling total - from between --
select *, sum(sales) over(order by productID rows between 2 preceding and current row)
from orders

-- calculate the average sales of current and next row --
select *, avg(sales) over(order by productID rows between current row and 1 following)
from orders

-- segment all orders into 3 categories High Medium and Low--

Select *,
Case when buckets = 1 then 'High'
when buckets = 2 then 'Medium'
when buckets = 3 then 'High'
END
from(
select *, ntile(3) over(order by OrderID) as buckets
from orders)t

-- Cume_Dist - Find products that fall within highest 40% --
select *, Concat(cume_dist*100, '%') as percent_dist
from (
select *, CUME_DIST() over(order by price desc) as cume_dist
from products
)t
where cume_dist <= 0.4
