--Stored procedure---
alter procedure US_details @CountryName nvarchar(20) = 'USA'
as 
begin
begin try
declare @total_score int, @avg_score float;

IF exists (select 1 from customers where score is Null and country = @CountryName)
begin
 Print 'Updating customers with null score to 0'
 update customers
 set score = 0
 where score is null and country = @CountryName
end

else
begin
	Print 'No customers with null score'
end;

select @total_score=count(*), @avg_score=avg(coalesce(score, 0))
from customers
where country = @CountryName;

PRINT 'Total customers from the ' + @CountryName + ':' + cast(@total_score as nvarchar);

select sum(sales) as total_sales, count(*) as total_orders, 1/0
from orders
join customers
on customers.CustomerID = orders.CustomerID
where customers.Country = 'USA';
end try

begin catch
print('error occured')
print(error_message())
print(error_number())
print(error_line())
print(error_procedure())
end catch
end

-- execute the stored procedure--
exec US_details @CountryName = 'USA'
